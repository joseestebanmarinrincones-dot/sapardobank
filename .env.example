# Copia este archivo a .env y ajusta los valores.
# Tokens: si dejas LIBRETA_API_TOKEN vacío, el servidor generará uno en
# server_data/token.txt y lo mostrará al arrancar.

LIBRETA_DATA_DIR=./server_data
LIBRETA_HOST=0.0.0.0
LIBRETA_PORT=8787
LIBRETA_API_TOKEN=

# URL pública HTTPS del servidor. Necesaria para webhooks de Plaid.
LIBRETA_PUBLIC_BASE_URL=https://libreta.example.com
LIBRETA_DAILY_BUDGET_CENTS=45000

# Plaid (sandbox o production)
LIBRETA_PLAID_CLIENT_ID=
LIBRETA_PLAID_SECRET=
LIBRETA_PLAID_ENV=sandbox
LIBRETA_PLAID_COUNTRIES=US,CA

# Seguridad de webhooks
LIBRETA_BANK_WEBHOOK_SECRET=
LIBRETA_WEBHOOK_PATH_SECRET=
LIBRETA_ALLOWED_OUTBOUND_HOSTS=sandbox.plaid.com,production.plaid.com
LIBRETA_RATE_LIMIT_PER_MINUTE=120
LIBRETA_TRUSTED_HOSTS=*

# La app móvil debe apuntar a: https://tu-dominio
# y usar el token de server_data/token.txt.
